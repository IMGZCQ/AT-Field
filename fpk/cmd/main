#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# 运行时配置，对应 internal/config/config.go 的环境变量约定
# ATFF_HOME 必须指向可写目录；ATFF_SOCK 必须放在 target 目录下，统一网关才能找到
export ATFF_HOME="${TRIM_PKGVAR}"
export ATFF_SOCK="${TRIM_APPDEST}/AT-ForceField.sock"
export ATFF_BASE_PATH="/app/AT-ForceField"

# 运行数据写入声明的共享目录，用户可在文件管理器中直接备份/恢复
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
if [ -n "${DATA_DIR}" ]; then
    export ATFF_DATA_DIR="${DATA_DIR}"
fi

# 判断运行设备架构，决定使用哪个二进制
case "$(uname -m)" in
x86_64 | amd64)
    APP_ARCH="amd64"
    ;;
aarch64 | arm64)
    APP_ARCH="arm64"
    ;;
*)
    APP_ARCH=""
    ;;
esac

# 完整 CMD
CMD="${TRIM_APPDEST}/at-forcefield-linux-${APP_ARCH}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

fail_msg() {
    log_msg "$1"
    echo "$1" > "${TRIM_TEMP_LOGFILE}"
}

start_process() {
    if status; then
        return 0
    fi

    if [ -z "${APP_ARCH}" ]; then
        fail_msg "不支持当前设备架构 $(uname -m)，仅支持 x86_64(amd64) 与 aarch64(arm64)"
        return 1
    fi

    if [ ! -f "${CMD}" ]; then
        fail_msg "未找到可执行文件 ${CMD}"
        return 1
    fi

    # 打包时会丢失执行权限，启动前补上
    chmod +x "${CMD}" >> ${LOG_FILE} 2>&1

    log_msg "Starting process (arch=${APP_ARCH}) ..."
    "${CMD}" >> ${LOG_FILE} 2>&1 &
    # write pid to pidfile
    printf "%s" "$!" > ${PID_FILE}
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        log_msg "pid=${pid}"
        if check_process "${pid}"; then
            log_msg "send TERM signal to PID:${pid}..."
            kill -TERM ${pid} >> ${LOG_FILE} 2>&1

            local count=0
            while check_process "${pid}" && [ $count -lt 15 ]; do
                sleep 1
                count=$((count + 1))
                log_msg "waiting process terminal... (${count}s/15s)"
            done

            if check_process "${pid}"; then
                log_msg "send KILL signal to PID:${pid}..."
                kill -KILL "${pid}"
                sleep 1
            else
                log_msg "process killed... "
            fi
        fi

        rm -f "${PID_FILE}"
    fi

    # 强杀路径不会走优雅退出，socket 文件需要手动清理
    rm -f "${ATFF_SOCK}"

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi
    fi

    return 1
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    if start_process; then
        exit 0
    else
        exit 1
    fi
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_process
    exit 0
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    echo "Unknown command: $1" > "${TRIM_TEMP_LOGFILE}"
    exit 1
    ;;
esac
